# --- Site ----------------------------------------------------------------------
# Public URL (canonical links, Open Graph, sitemap, auth redirects, Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (São Paulo: sa-east-1) ----------------------------------------------
# Local stack (npm run db:start): values from `npx supabase status` (API URL, publishable/anon, secret/service_role).
# Vercel: Production -> production project; Preview -> STAGING project (never production).
# Project Settings > API: URL + publishable key (sb_publishable_... or legacy anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_... or legacy service_role). SERVER ONLY: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Social login (OPTIONAL): enable Google in Supabase > Authentication > Providers, then set to true
NEXT_PUBLIC_AUTH_GOOGLE=

# --- Cloudflare Turnstile (REQUIRED in production) -------------------------------------
# Cloudflare > Turnstile > Add site. The same secret goes to Supabase Auth captcha (SUPABASE_AUTH_CAPTCHA_SECRET in
# supabase/.env for the local stack and `npm run supabase:config:push`, or Auth > Attack Protection).
# Values below are Cloudflare TEST keys (always pass): fine locally/CI, refused in production (Vercel).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production refuses to start without Turnstile. Set to true only to run without it ON PURPOSE (keys empty).
TURNSTILE_DISABLED=

# --- Admin -----------------------------------------------------------------------------------
# /admin requires two-step verification (TOTP, aal2). Default: true in production builds, false in `next dev`.
ADMIN_REQUIRE_MFA=

# --- Resend (OPTIONAL: empty = e-mails are only logged) ---------------------------------
RESEND_API_KEY=
# Must use a domain verified in Resend
EMAIL_FROM=App <onboarding@resend.dev>
# Inbox that receives the contact form (empty = only logged)
CONTACT_EMAIL=

# --- Stripe (OPTIONAL: empty = /api/stripe/* answers 503) ------------------------------
STRIPE_SECRET_KEY=
# Developers > Webhooks > endpoint <SITE_URL>/api/stripe/webhook (local: stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Comma-separated price_... ids the checkout accepts (required in production when Stripe is on)
STRIPE_PRICE_IDS=
# Price used by the demo "Assinar" button
NEXT_PUBLIC_STRIPE_PRICE_ID=

# --- Sentry (OPTIONAL: empty = disabled) ------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload on deploy only
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Migrations in the Vercel build (scripts/build.mjs) -----------------------------------
# Not read by the app. Vercel has no build-only variables, so these are also present at runtime: use a strong,
# rotated database password and never a NEXT_PUBLIC_ name (the service-role key is already as powerful for data).
# Vercel "Production" ONLY: Session pooler URI (port 5432; Vercel has no IPv6 for the direct host). Must be the same
# project as NEXT_PUBLIC_SUPABASE_URL. `npm run build` migrates before `next build`; failure = deploy fails.
SUPABASE_DB_URL=
# Production AND Preview: ref of the production project. A preview never migrates a database with this ref.
SUPABASE_PRODUCTION_REF=
# Preview only, off by default: "true" + SUPABASE_STAGING_DB_URL migrate the STAGING project on preview deploys.
# With several open PRs a shared staging database breaks (prefer Supabase Branching for per-PR databases).
SUPABASE_MIGRATE_PREVIEW=
SUPABASE_STAGING_DB_URL=

# --- Feature flags (src/lib/flags.ts) --------------------------------------------------
# FLAG_<KEY>=true|false sets the default per environment; a row in public.feature_flags wins over it.
# FLAG_NOVO_PAINEL=

# --- Cron (Vercel) ------------------------------------------------------------------------
# REQUIRED in production (min. 16 chars, e.g. `openssl rand -hex 32`). Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>" to /api/cron/*; the same header unlocks details in /api/health.
CRON_SECRET=
