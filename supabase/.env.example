# Copy to supabase/.env (git-ignored). Read by the Supabase CLI for env(...) values in config.toml.
# Turnstile secret checked by Supabase Auth (captcha). Local/CI: Cloudflare's always-pass TEST secret.
# Production: the real secret, the same as TURNSTILE_SECRET_KEY in the app.
SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA
